### Security — never commit these ───────────────────────────
# Self-signed keystore (dev only — regenerate on each machine)
src/main/resources/*.p12
src/main/resources/*.jks
src/main/resources/*.keystore

# Environment / secrets files
.env
.env.*
*.env

# Production config overrides
application-prod-local.properties

